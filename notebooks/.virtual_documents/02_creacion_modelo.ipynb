





# Importar el paquete GeoAI
import geoai


# Especificar las carpetas
models_path = "../geoai/models"
images_path = "../geoai/train/output/images"
masks_path = "../geoai/train/output/masks"
test_path = "../geoai/test"

get_ipython().run_line_magic("config", " Completer.use_jedi = False")





# Adaptar el modelo U-Net con codificación ResNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_resnet",
    architecture="unet",
    encoder_name="resnet34",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)


# Adaptar el modelo U-Net con codificación MobileNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_mobilenet",
    architecture="unet",
    encoder_name="mobilenet_v2",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,  
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)


# Adaptar el modelo U-Net con codificación EfficientNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_efficientnet",
    architecture="unet",
    encoder_name="efficientnet-b1",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,  
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)





# Evaluar el modelo U-Net con codificación ResNet
resnet_path = f"{models_path}/unet_resnet"

geoai.plot_performance_metrics(
    history_path=f"{resnet_path}/training_history.pth",
    figsize=(15, 5),
    verbose=True
)


# Evaluar el modelo U-Net con codificación MobileNet
mobilenet_path = f"{models_path}/unet_mobilenet"

geoai.plot_performance_metrics(
    history_path=f"{mobilenet_path}/training_history.pth",
    figsize=(15, 5),
    verbose=True
)


# Evaluar el modelo U-Net con codificación EfficientNet
efficientnet_path = f"{models_path}/unet_efficientnet"

geoai.plot_performance_metrics(
    history_path=f"{efficientnet_path}/training_history.pth",
    figsize=(15, 5),
    verbose=True
)





# Predecir con ResNet
prediction_path = f"{test_path}/output/test_area_resnet.tif"

geoai.semantic_segmentation(
        input_path=f"{test_path}/test_area.tif",
        output_path=prediction_path,
        model_path=f"{resnet_path}/best_model.pth",
        architecture="unet",
        encoder_name="resnet34",
        num_channels=3,
        num_classes=2,
        window_size=512,      # Tamaño de ventana deslizante
        overlap=256,          # Solapamiento para suavizar bordes
        batch_size=8
    )

# Vectorizar la imagen
resnet_vector_path = f"{test_path}/output/test_area_resnet.geojson"
gdf = geoai.orthogonalize(prediction_path, resnet_vector_path, epsilon=2)

# Añadir propiedades geométricas
resnet_props = geoai.add_geometric_properties(gdf, area_unit="m2", length_unit="m")


# Predecir con MobileNet
prediction_path = f"{test_path}/output/test_area_mobilenet.tif"

geoai.semantic_segmentation(
        input_path=f"{test_path}/test_area.tif",
        output_path=prediction_path,
        model_path=f"{mobilenet_path}/best_model.pth",
        architecture="unet",
        encoder_name="mobilenet_v2",
        num_channels=3,
        num_classes=2,
        window_size=512,      # Tamaño de ventana deslizante
        overlap=256,          # Solapamiento para suavizar bordes
        batch_size=8
    )

# Vectorizar la imagen
mobilenet_vector_path = f"{test_path}/output/test_area_mobilenet.geojson"
gdf = geoai.orthogonalize(prediction_path, mobilenet_vector_path, epsilon=2)

# Añadir propiedades geométricas
mobilenet_props = geoai.add_geometric_properties(gdf, area_unit="m2", length_unit="m")


# Predecir con EfficientNet
prediction_path = f"{test_path}/output/test_area_efficientnet.tif"

geoai.semantic_segmentation(
        input_path=f"{test_path}/test_area.tif",
        output_path=prediction_path,
        model_path=f"{efficientnet_path}/best_model.pth",
        architecture="unet",
        encoder_name="efficientnet-b1",
        num_channels=3,
        num_classes=2,
        window_size=512,      # Tamaño de ventana deslizante
        overlap=256,          # Solapamiento para suavizar bordes
        batch_size=8
    )

# Vectorizar la imagen
efficientnet_vector_path = f"{test_path}/output/test_area_efficientnet.geojson"
gdf = geoai.orthogonalize(prediction_path, efficientnet_vector_path, epsilon=2)

# Añadir propiedades geométricas
efficientnet_props = geoai.add_geometric_properties(gdf, area_unit="m2", length_unit="m")





import leafmap.leafmap as leafmap
import ipywidgets as w

# 1. Rutas
# test_path = "."  # Ajusta esto si tu carpeta base es diferente
# ruta_der = f"{test_path}/output/test_area_unet_mobilenet.geojson"
# ruta_izq = f"{test_path}/output/test_area_resnet.geojson"
tif_path = f"{test_path}/test_area.tif"

url = "https://idecan1.grafcan.es/ServicioWMS/Historico/Ortofotos/OrtoExpress_2021"
layers = "ortoexpress"

# Configuración: (Ruta GeoJSON, Color) -> El orden define (Mapa Izq, Mapa Der)
data = [(efficientnet_props, "blue"), (mobilenet_props, "red")]

# 2. Crear Mapas (Ajustado a Canarias, zoom=12)
maps = [leafmap.Map(draw_control=False, layers_control=(i == 0)) for i in range(2)]

# 3. Configurar capas y sincronizar
for m, (geojson, color) in zip(maps, data):
    # Capa base WMS (Ortofoto)
    m.add_wms_layer(url, layers, name=" Ortofoto Territorial Año 2021", format="image/jpeg")
    
    # Raster de fondo y GeoJSON específico
    m.add_raster(tif_path, layer_name="Fondo TIF")
    m.add_geojson(geojson, layer_name="Modelo", style={'color': color, 'fillOpacity': 0.1, 'weight': 2})

w.jslink((maps[0], 'center'), (maps[1], 'center'))
w.jslink((maps[0], 'zoom'), (maps[1], 'zoom'))

# 4. Mostrar
maps[0].layout.width = maps[1].layout.width = '50%'
display(w.HBox(maps, layout=w.Layout(height='600px')))


import leafmap.leafmap as leafmap
import ipywidgets as w

# 1. Rutas
# test_path = "."  # Ajusta esto si tu carpeta base es diferente
# ruta_der = f"{test_path}/output/test_area_unet_mobilenet.geojson"
# ruta_izq = f"{test_path}/output/test_area_resnet.geojson"
tif_path = f"{test_path}/test_area.tif"

wms_url = "https://idecan1.grafcan.es/ServicioWMS/Historico/Ortofotos/OrtoExpress_2021"

# Configuración: (Ruta GeoJSON, Color) -> El orden define (Mapa Izq, Mapa Der)
data = [(resnet_props, "green"), (mobilenet_props, "red")]

# 2. Crear Mapas (Ajustado a Canarias, zoom=12)
maps = [leafmap.Map(draw_control=False, layers_control=(i == 0)) for i in range(2)]

# 3. Configurar capas y sincronizar
for m, (geojson, color) in zip(maps, data):
    # Capa base WMS (Ortofoto)
    m.add_wms_layer(
        wms_url, 
        layers="OrtoExpress",
        name=" Ortofoto Territorial Año 2021",
        format="image/jpeg",
        attribution="Grafcan"
    )
    
    # Raster de fondo y GeoJSON específico
    m.add_raster(tif_path, layer_name="Fondo TIF")
    m.add_geojson(geojson, layer_name="Modelo", style={'color': color, 'fillOpacity': 0.1, 'weight': 2})

w.jslink((maps[0], 'center'), (maps[1], 'center'))
w.jslink((maps[0], 'zoom'), (maps[1], 'zoom'))

# 4. Mostrar
maps[0].layout.width = maps[1].layout.width = '50%'
display(w.HBox(maps, layout=w.Layout(height='600px')))



