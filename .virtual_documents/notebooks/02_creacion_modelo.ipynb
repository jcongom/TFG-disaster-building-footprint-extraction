





# Importar el paquete GeoAI
import geoai


# Especificar las carpetas
models_path = "../geoai/models"
images_path = "../geoai/train/output/images"
masks_path = "../geoai/train/output/masks"
test_path = "../geoai/test"

get_ipython().run_line_magic("config", " Completer.use_jedi = False")





# Adaptar el modelo U-Net con codificación ResNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_resnet",
    architecture="unet",
    encoder_name="resnet34",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)


# Adaptar el modelo U-Net con codificación MobileNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_mobilenet",
    architecture="unet",
    encoder_name="mobilenet_v2",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)


# Adaptar el modelo U-Net con codificación EfficientNet
geoai.train_segmentation_model(
    images_dir=images_path,
    labels_dir=masks_path,
    output_dir=f"{models_path}/unet_efficientnet",
    architecture="unet",
    encoder_name="efficientnet-b1",
    encoder_weights="imagenet",
    num_channels=3,
    num_classes=2,
    batch_size=8,
    num_epochs=50,
    learning_rate=0.001,
    val_split=0.2,
    verbose=False,
)





# Evaluar el modelo U-Net con codificación ResNet
resnet_path = f"{models_path}/unet_resnet"

geoai.plot_performance_metrics(
    history_path=f"{resnet_path}/training_history.pth", figsize=(15, 5), verbose=True
)


# Evaluar el modelo U-Net con codificación MobileNet
mobilenet_path = f"{models_path}/unet_mobilenet"

geoai.plot_performance_metrics(
    history_path=f"{mobilenet_path}/training_history.pth", figsize=(15, 5), verbose=True
)


# Evaluar el modelo U-Net con codificación EfficientNet
efficientnet_path = f"{models_path}/unet_efficientnet"

geoai.plot_performance_metrics(
    history_path=f"{efficientnet_path}/training_history.pth",
    figsize=(15, 5),
    verbose=True,
)





# Predecir con ResNet
prediction_path = f"{test_path}/output/test_area_resnet.tif"

geoai.semantic_segmentation(
    input_path=f"{test_path}/test_area.tif",
    output_path=prediction_path,
    model_path=f"{resnet_path}/best_model.pth",
    architecture="unet",
    encoder_name="resnet34",
    num_channels=3,
    num_classes=2,
    window_size=512,  # Tamaño de ventana deslizante
    overlap=256,  # Solapamiento para suavizar bordes
    batch_size=8,
)

# Vectorizar la imagen
resnet_vector_path = f"{test_path}/output/test_area_resnet.geojson"
geoai.orthogonalize(prediction_path, resnet_vector_path, epsilon=2)


# Predecir con MobileNet
prediction_path = f"{test_path}/output/test_area_mobilenet.tif"

geoai.semantic_segmentation(
    input_path=f"{test_path}/test_area.tif",
    output_path=prediction_path,
    model_path=f"{mobilenet_path}/best_model.pth",
    architecture="unet",
    encoder_name="mobilenet_v2",
    num_channels=3,
    num_classes=2,
    window_size=512,  # Tamaño de ventana deslizante
    overlap=256,  # Solapamiento para suavizar bordes
    batch_size=8,
)

# Vectorizar la imagen
mobilenet_vector_path = f"{test_path}/output/test_area_mobilenet.geojson"
geoai.orthogonalize(prediction_path, mobilenet_vector_path, epsilon=2)


# Predecir con EfficientNet
prediction_path = f"{test_path}/output/test_area_efficientnet.tif"

geoai.semantic_segmentation(
    input_path=f"{test_path}/test_area.tif",
    output_path=prediction_path,
    model_path=f"{efficientnet_path}/best_model.pth",
    architecture="unet",
    encoder_name="efficientnet-b1",
    num_channels=3,
    num_classes=2,
    window_size=512,  # Tamaño de ventana deslizante
    overlap=256,  # Solapamiento para suavizar bordes
    batch_size=8,
)

# Vectorizar la imagen
efficientnet_vector_path = f"{test_path}/output/test_area_efficientnet.geojson"
geoai.orthogonalize(prediction_path, efficientnet_vector_path, epsilon=2)





import ipywidgets as w
import leafmap.leafmap as leafmap

efficientnet_vector_path = f"{test_path}/output/test_area_efficientnet.geojson"
resnet_vector_path = f"{test_path}/output/test_area_resnet.geojson"
mobilenet_vector_path = f"{test_path}/output/test_area_mobilenet.geojson"


# Añadir propiedades geométricas
resnet_props = geoai.add_geometric_properties(
    resnet_vector_path, area_unit="m2", length_unit="m"
)
mobilenet_props = geoai.add_geometric_properties(
    mobilenet_vector_path, area_unit="m2", length_unit="m"
)

data = [
    (mobilenet_props, "red", "Modelo: U-Net + MobileNetV2"),
    (resnet_props, "orange", "Modelo: U-Net + ResNet-34"),
]

maps = [
    leafmap.Map(
        center=[28.6162, -17.8986],
        zoom=16,
        min_zoom=15,
        max_zoom=20,
        toolbar_control=False,
        draw_control=False,
        fullscreen_control=False,
        layers_control=True,
    )
    for i in range(2)
]

for m, (geojson, color, model_name) in zip(maps, data):
    m.clear_layers()

    m.add_wms_layer(
        url="https://idecan1.grafcan.es/ServicioWMS/Historico/Ortofotos/OrtoExpress_2021?",
        layers="WMS_OrtoExpress",
        name="IDECanarias OrtoExpress 2021 (20 cm/pixel)",
        attribution='<a href="https://www.grafcan.es/aviso-legal/" target="_blank">GRAFCAN</a>, Ortofotos Express de Canarias',
        format="image/jpeg",
        max_zoom=20,
        base=True,
    )

    m.add_gdf(
        geojson,
        layer_name=model_name,
        style={"color": color, "fillOpacity": 0.25, "weight": 2},
        zoom_to_layer=True,
    )

w.jslink((maps[0], "center"), (maps[1], "center"))
w.jslink((maps[0], "zoom"), (maps[1], "zoom"))

maps[0].layout.width = maps[1].layout.width = "50%"
display(w.HBox(maps, layout=w.Layout(height="600px")))


