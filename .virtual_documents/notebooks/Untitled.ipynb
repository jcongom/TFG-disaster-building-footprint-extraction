import os

import geopandas as gpd
from IPython.display import IFrame

# --- 1. PREPARAR DATOS ---
path_eff = "../geoai/test/output/test_area_efficientnet.geojson"
path_mob = "../geoai/test/output/test_area_mobilenet.geojson"

# Leemos los vectores y los convertimos a texto JSON para incrustarlos
gdf_eff = gpd.read_file(path_eff)
gdf_mob = gpd.read_file(path_mob)

# Calcular el centro del mapa automáticamente para que no salga el mar
center_lat = gdf_eff.geometry.centroid.y.mean()
center_lon = gdf_eff.geometry.centroid.x.mean()

json_eff = gdf_eff.to_json()
json_mob = gdf_mob.to_json()

# --- 2. GENERAR HTML SINCRONIZADO ---
html_content = f"""
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Comparativa IA Sincronizada</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
    <style>
        body {{ margin: 0; padding: 0; display: flex; height: 100vh; width: 100vw; }}
        /* Dividimos la pantalla en dos mitades exactas */
        #mapLeft {{ width: 50%; height: 100%; border-right: 2px solid white; }}
        #mapRight {{ width: 50%; height: 100%; }}
        
        /* Etiquetas flotantes para saber qué es cada cosa */
        .label {{
            position: absolute; top: 10px; left: 50px; z-index: 1000;
            background: white; padding: 5px 10px; border-radius: 4px;
            font-family: sans-serif; font-weight: bold;
            box-shadow: 0 0 5px rgba(0,0,0,0.3);
        }}
    </style>
</head>
<body>

<div id="mapLeft">
    <div class="label" style="color: chocolate;">EfficientNet (Naranja)</div>
</div>
<div id="mapRight">
    <div class="label" style="color: crimson;">MobileNet (Rojo)</div>
</div>

<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.sync/L.Map.Sync.js"></script>

<script>
    // 1. Configuración WMS (Ortofoto)
    var wmsUrl = "https://idecan1.grafcan.es/ServicioWMS/Historico/Ortofotos/OrtoExpress_2021";
    var wmsOptions = {{
        layers: 'ortoexpress',
        format: 'image/jpeg',
        transparent: true,
        attribution: 'Grafcan'
    }};

    // 2. Crear Mapa Izquierdo
    var mapLeft = L.map('mapLeft', {{
        center: [{center_lat}, {center_lon}],
        zoom: 17,
        zoomControl: false // Quitamos controles para limpiar la vista
    }});
    L.tileLayer.wms(wmsUrl, wmsOptions).addTo(mapLeft);

    // 3. Crear Mapa Derecho
    var mapRight = L.map('mapRight', {{
        center: [{center_lat}, {center_lon}],
        zoom: 17,
        zoomControl: false
    }});
    L.tileLayer.wms(wmsUrl, wmsOptions).addTo(mapRight);

    // 4. Añadir los Vectores (Aquí usamos tus datos reales)
    var dataEff = {json_eff};
    var dataMob = {json_mob};

    L.geoJSON(dataEff, {{
        style: {{ color: 'orange', weight: 2, fillOpacity: 0.2 }}
    }}).addTo(mapLeft);

    L.geoJSON(dataMob, {{
        style: {{ color: 'red', weight: 2, fillOpacity: 0.2 }}
    }}).addTo(mapRight);

    // 5. ¡SINCRONIZACIÓN!
    // Le decimos a cada mapa que "siga" al otro
    mapLeft.sync(mapRight);
    mapRight.sync(mapLeft);

</script>
</body>
</html>
"""

# --- 3. GUARDAR Y MOSTRAR ---
output_file = "comparativa_sincronizada.html"
with open(output_file, "w") as f:
    f.write(html_content)

print(f"¡Mapa generado con éxito! Abre: {os.path.abspath(output_file)}")
IFrame(src=output_file, width="100%", height="600px")



