# 1. Definir rutas absolutas
input_eff = os.path.abspath("../geoai/test/output/test_area_efficientnet.geojson")
input_mob = os.path.abspath("../geoai/test/output/test_area_mobilenet.geojson")
out_eff = os.path.abspath("efficientnet_fix.tif")
out_mob = os.path.abspath("mobilenet_fix.tif")


def crear_raster_transparente(input_vec, output_ras, pixel_size=0.000005):
    # Abrir vector
    vec_ds = ogr.Open(input_vec)
    lyr = vec_ds.GetLayer()
    x_min, x_max, y_min, y_max = lyr.GetExtent()

    # Calcular tamaño
    cols = int((x_max - x_min) / pixel_size)
    rows = int((y_max - y_min) / pixel_size)

    # Crear TIF
    driver = gdal.GetDriverByName("GTiff")
    out_ds = driver.Create(output_ras, cols, rows, 1, gdal.GDT_Byte)
    out_ds.SetGeoTransform((x_min, pixel_size, 0, y_max, 0, -pixel_size))
    out_ds.SetProjection(lyr.GetSpatialRef().ExportToWkt())

    # CLAVE: Configurar la banda
    band = out_ds.GetRasterBand(1)

    # 1. Llenar todo de ceros (fondo)
    band.Fill(0)
    # 2. Decirle al archivo que el 0 es "No Data" (Transparente)
    band.SetNoDataValue(0)

    # 3. Quemar los polígonos con valor 1 (no 255, usaremos 1 para simplificar la paleta)
    gdal.RasterizeLayer(out_ds, [1], lyr, burn_values=[1])

    out_ds.FlushCache()
    out_ds = None
    print(f"Generado: {output_ras}")


crear_raster_transparente(input_eff, out_eff)
crear_raster_transparente(input_mob, out_mob)


